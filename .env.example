# Server binding (Caddy / GCP Load Balancer reverse-proxies to this local address)
HOST=127.0.0.1
PORT=8080
PUBLIC_BASE_URL=https://demos.example.com
TRUST_PROXY=true

# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-32-byte-hex-secret

# GCP Identity-Aware Proxy (IAP) authenticated user header
IAP_EMAIL_HEADER=x-goog-authenticated-user-email

# Local xrdp target on the Debian VM
RDP_HOST=127.0.0.1
RDP_PORT=3389

# Local Linux user provisioning & password store (defaults to ./users.yaml in start directory)
USERS_FILE=./users.yaml
USE_SUDO=true
VM_USER_SHELL=/bin/bash
VM_USER_GROUPS=
SETUP_USER_SCRIPT=
ON_CONNECT_SCRIPT=./scripts/on-connect.sh
