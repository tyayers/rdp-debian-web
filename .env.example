# Server binding (Caddy reverse-proxies to this local address)
HOST=127.0.0.1
PORT=8080
PUBLIC_BASE_URL=https://demos.example.com
TRUST_PROXY=true

# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-32-byte-hex-secret

# Google OAuth 2.0 Web Application credentials
# Authorized redirect URI: https://demos.example.com/api/auth/google/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
ALLOWED_GOOGLE_DOMAIN=google.com

# Local xrdp target on the Debian VM
RDP_HOST=127.0.0.1
RDP_PORT=3389

# VM user management ("system" on the Debian VM, "mock" for non-root local dev)
VM_USER_MODE=system
# Automatically defaults to true when not running as root (uses passwordless `sudo -n` for useradd/chpasswd)
USE_SUDO=true
VM_USER_SHELL=/bin/bash
VM_USER_GROUPS=
# Optional script invoked after first-time user creation: <script> <username> <homedir>
SETUP_USER_SCRIPT=

# Strictly false in production; set true only for local UI testing without Google OAuth
ALLOW_DEV_AUTH=false
