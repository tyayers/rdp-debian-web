# Server binding (0.0.0.0 for direct VM/LB access on port 8080, or 127.0.0.1 behind Caddy)
HOST=0.0.0.0
PORT=8080
# Optional primary external URL; leave empty to infer from Host / X-Forwarded-Host
PUBLIC_BASE_URL=https://demos.example.com
# Optional comma-separated list of additional allowed WebSocket origins/hosts (for multiple domains)
ALLOWED_ORIGINS=
TRUST_PROXY=true

# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-32-byte-hex-secret

# GCP Identity-Aware Proxy (IAP) authenticated user header
IAP_EMAIL_HEADER=x-goog-authenticated-user-email

# Local xrdp target on the Debian VM
RDP_HOST=127.0.0.1
RDP_PORT=3389

# Local Linux user provisioning & password store (defaults to ./users.yaml in start directory)
USERS_FILE=./users.yaml
USE_SUDO=true
VM_USER_SHELL=/bin/bash
VM_USER_GROUPS=
SETUP_USER_SCRIPT=
ON_CONNECT_SCRIPT=./scripts/on-connect.sh

# Optional Antigravity enterprise gateway configuration (writes /etc/antigravity/admin_settings.json on startup)
ANTIGRAVITY_URL=
ANTIGRAVITY_KEY=

# Optional Claude Code gateway/model configuration (writes /etc/claude-code/managed-settings.json on startup)
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_OPUS_MODEL=
ANTHROPIC_DEFAULT_SONNET_MODEL=
ANTHROPIC_DEFAULT_HAIKU_MODEL=
